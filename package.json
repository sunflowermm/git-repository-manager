{
  "name": "git-manager-electron",
  "version": "1.2.15",
  "description": "🌻 向日葵Git仓库管理 - Electron版",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "build": "npm run build:ui && electron-builder --publish=never",
    "build:x64": "npm run build:ui && electron-builder --win --x64 --publish=never",
    "build:ia32": "npm run build:ui && electron-builder --win --ia32 --publish=never",
    "publish": "npm run build:ui && node publish.js"
  },
  "keywords": [
    "git",
    "repository",
    "manager",
    "electron"
  ],
  "author": "向日葵",
  "license": "MIT",
  "devDependencies": {
    "@octokit/rest": "^20.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.1.7",
    "fuse.js": "^7.5.0",
    "marked": "^18.0.7",
    "notyf": "^3.10.0",
    "simple-git": "^3.25.0",
    "sortablejs": "^1.15.7",
    "split.js": "^1.6.5",
    "vue": "^3.5.40"
  },
  "build": {
    "appId": "com.sunflower.gitmanager",
    "productName": "向日葵Git仓库管理",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "update-config.json",
      "ui-dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.bin/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.txt",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/README*",
      "!node_modules/**/.git/**/*",
      "!node_modules/**/.github/**/*",
      "!dist/**/*",
      "!history/**/*",
      "!src/**/*",
      "!renderer.js",
      "!styles.css",
      "!index.html",
      "!vite.config.js"
    ],
    "asarUnpack": [
      "node_modules/@kwsites/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "sunflowermm",
      "repo": "git-repository-manager",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  }
}
